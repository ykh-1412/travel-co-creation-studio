# AI provider: deepseek / doubao / ollama / demo
AI_PROVIDER=deepseek

# Shared website password. Change this on every server.
PUBLIC_ACCESS_PASSWORD=change-me

# Set to true when the server is exposed through your own HTTPS domain.
PUBLIC_REQUIRE_PASSWORD=true

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Doubao settings
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional local Ollama settings
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# API entry port. The website itself runs internally on port 3000.
API_PORT=8787

# Active trip project. `npm run trip:new -- --destination=苏州 --slug=suzhou`
# creates a separate data file and updates these three local settings.
TRIP_DATA_FILE=data/store.json
TRIP_OUTPUT_DIR=outputs/current
WORKBOOK_FILE_NAME=出行共创项目.xlsx
