# AI provider: deepseek / doubao / ollama / demo
AI_PROVIDER=deepseek

# Shared website password. Change this on every server.
PUBLIC_ACCESS_PASSWORD=change-me

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Doubao settings
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional local Ollama settings
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local organizer port and public team port. The website itself runs internally on port 3100.
UI_PORT=3100
API_PORT=8887
PUBLIC_API_PORT=8888

# Active trip project. `npm run trip:new -- --destination=苏州 --slug=suzhou`
# creates a separate data file and updates these three local settings.
TRIP_DATA_FILE=data/store.json
TRIP_OUTPUT_DIR=outputs/019fa660-42f1-74a1-ab98-31c99abb6300
WORKBOOK_FILE_NAME=韩国济州岛旅行共创.xlsx
